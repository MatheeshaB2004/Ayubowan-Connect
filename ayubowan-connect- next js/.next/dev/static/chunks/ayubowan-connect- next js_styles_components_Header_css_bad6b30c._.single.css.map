/* Main Header Container */
.global-header {
  position: fixed;
  top: 0;
  width: 100%;
  z-index: 50;
  transition: transform 0.3s ease-in-out, background-color 0.3s ease, color 0.3s ease;
  height: 5rem; /* h-20 */
  display: flex;
  align-items: center;
}

/* Override container max-width for header to reduce side spacing */
.header-container.container {
  max-width: 95%;
}

.global-header.hidden-header {
  transform: translateY(-100%);
}

/* State: Transparent (Home Top) */
.global-header.header-transparent {
  background-color: transparent;
  color: white;
  box-shadow: none;
}

/* State: Solid (Scrolled or other pages) */
.global-header.header-solid {
  background-color: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  color: #374151; /* gray-700 */
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
}

.header-container {
  height: 100%;
}

.header-content {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  height: 100%;
}

/* Utils */
.z-10 { z-index: 10; }

/* Logo */
.brand-logo {
  font-family: var(--font-serif);
  font-size: 1.5rem;
  font-weight: 700;
  font-style: italic;
  letter-spacing: 0.025em;
  text-decoration: none;
  color: inherit;
}

/* Logo Container */
.logo-container {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  min-width: auto; /* Allow it to shrink */
  height: 100%;
  margin-left: -1rem; /* Pull left slightly */
  transform: translateY(5px); /* Move down */
}

/* Logo Image State */
.logo-image {
  height: 5rem; 
  width: auto;
  max-width: 200px; /* Arbitrary large enough value */
  transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  opacity: 1;
  transform: translateY(0) scale(1);
  filter: drop-shadow(0 4px 6px rgba(0,0,0,0.1));
  margin-right: 1rem; 
}

.logo-image.hidden-logo {
  opacity: 0;
  max-width: 0; /* Animate max-width for smooth collapse */
  margin-right: 0;
  transform: translateY(-20px) scale(0.9);
  pointer-events: none;
}

/* Brand Text Container */
.brand-text-container {
  display: flex;
  transition: all 0.5s ease;
}

.brand-text-container.layout-stacked {
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  line-height: 1.1;
}

.brand-text-container.layout-inline {
  flex-direction: row;
  align-items: center;
  gap: 0.4rem;
}

/* Brand Text Spans */
.brand-ayubowan, .brand-connect {
  font-family: var(--font-arima), serif;
  font-weight: 700;
  transition: all 0.5s ease;
}

.brand-ayubowan {
  color: #C69C6D; /* Gold/Brown */
}

.brand-connect {
  color: var(--lochinvar); /* Teal */
}

/* Stacked State Styles */
.layout-stacked .brand-ayubowan {
  font-size: 1.5rem;
}

.layout-stacked .brand-connect {
  font-size: 1.8rem;
}

/* Inline State Styles */
.layout-inline .brand-ayubowan,
.layout-inline .brand-connect {
  font-size: 1.25rem;
}

/* Animation for Logo */
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}
.animate-logo {
  animation: fadeInUp 0.8s ease-out forwards;
}

/* Desktop Nav Wrapper */
.desktop-nav {
  display: none;
  flex: 1;
  justify-content: flex-end;
  align-items: center;
}

@media (min-width: 768px) {
  .desktop-nav {
    display: flex;
  }
}

/* Navbar Guest Specifics */
.nav-guest-container {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

/* Centered Links for Guest */
.nav-links-center {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  gap: 2rem; /* space-x-8 */
  z-index: 100; /* Ensure links are above everything */
  pointer-events: auto;
}

.nav-link {
  font-size: 0.875rem; /* text-sm */
  font-weight: 500;
  transition: color 0.2s;
  text-decoration: none;
  color: inherit;
  cursor: pointer;
  position: relative;
  z-index: 101;
}

/* Hover States */
.header-transparent .nav-link:hover {
  color: var(--lochinvar) !important; 
}
.header-solid .nav-link:hover {
  color: var(--lochinvar) !important;
}

/* More Dropdown */
.more-dropdown-btn {
  display: flex;
  align-items: center;
  cursor: pointer;
  background: none;
  border: none;
  padding: 0.5rem 0;
}

.dropdown-menu {
  position: absolute;
  left: 0;
  top: 100%;
  width: 12rem;
  background: white;
  border-radius: 0.125rem;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  padding: 0.5rem 0;
  border: 1px solid var(--border-color);
  color: #374151;
  visibility: hidden;
  opacity: 0;
  transform-origin: top left;
  transition: all 0.2s;
}

.group:hover .dropdown-menu {
  visibility: visible;
  opacity: 1;
}

.dropdown-item {
  display: block;
  padding: 0.5rem 1rem;
  font-size: 0.875rem;
  color: #374151;
  text-decoration: none;
}

.dropdown-item:hover {
  background-color: var(--light-gray);
  color: var(--lochinvar);
}

/* Auth Buttons */
.auth-buttons {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-right: -0.5rem;
}

.btn-login {
  padding: 0.5rem 1.25rem;
  border-radius: 0.125rem;
  font-size: 0.875rem;
  font-weight: 500;
  transition: all 0.2s;
  border: 1px solid;
  background: transparent;
}

.header-transparent .btn-login {
  border-color: rgba(255, 255, 255, 0.3);
  color: white;
}
.header-transparent .btn-login:hover {
  background-color: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.5);
}

.header-solid .btn-login {
  border-color: #d1d5db;
  color: #374151;
}
.header-solid .btn-login:hover {
  background-color: #f9fafb;
  border-color: #9ca3af;
}

.btn-signup {
  background-color: var(--lochinvar);
  color: white;
  padding: 0.5rem 1.25rem;
  border-radius: 0.125rem;
  font-size: 0.875rem;
  font-weight: 500;
  border: none;
  cursor: pointer;
  transition: all 0.2s;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
}

.btn-signup:hover {
  background-color: var(--lochinvar-dark);
  box-shadow: 0 4px 6px -1px rgba(55, 150, 131, 0.2);
}

/* Mobile Menu */
.mobile-toggle {
  display: flex;
  background: none;
  border: none;
  cursor: pointer;
  color: inherit;
}

@media (min-width: 768px) {
  .mobile-toggle {
    display: none;
  }
}

.mobile-menu {
  background: white;
  border-top: 1px solid var(--border-color);
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.section-tag {
    font-size: 0.75rem;
    color: #9ca3af;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
}

.mobile-link {
  display: block;
  padding: 0.5rem 0;
  font-size: 1rem;
  font-weight: 500;
  color: #374151;
  text-decoration: none;
}

.mobile-link:hover {
  color: var(--lochinvar);
}

.mobile-menu-divider {
  border-top: 1px solid #e5e7eb;
  padding-top: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

/* Traveller / Vendor Nav */
.traveller-nav, .vendor-nav {
  display: flex;
  align-items: center;
  gap: 1.5rem;
}

.traveller-divider, .vendor-divider {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding-left: 1rem;
  border-left: 1px solid currentColor;
  opacity: 0.8;
}

.traveller-name, .vendor-name {
  font-size: 0.875rem;
  font-family: var(--font-serif);
  font-style: italic;
}

.logout-btn {
  color: #dc2626;
  font-size: 0.875rem;
  font-weight: 500;
  background: none;
  border: none;
  cursor: pointer;
}

.create-listing-btn {
  background-color: #111827;
  color: white;
  padding: 0.375rem 1rem;
  border-radius: 0.25rem;
  font-size: 0.875rem;
  text-decoration: none;
}