generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement()) @map("user_id")
  fullName     String        @map("full_name")
  email        String        @unique
  passwordHash String        @map("password_hash")
  role         UserRole      @default(USER)  
  lastLoginAt  DateTime?     @map("last_login_at")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  localTourist LocalTourist?
  reviews            Review[]
  profileViews       ProfileView[]
  listingViews       ListingView[]
  vendor             Vendor?
  bookings           Booking[]
  cart               Cart?
  eventRegistrations EventRegistration[]

  @@map("users")
}

model LocalTourist {
  userId                Int           @id @map("user_id")
  fullName              String        @map("full_name")
  profilePhotoUrl       String?       @map("profile_photo_url")
  userType              LocalUserType @map("user_type")
  nationality           String?
  dateOfBirth           DateTime?     @map("date_of_birth")
  preferredLanguage     String        @default("en") @map("preferred_language")
  isProUser             Boolean       @default(false) @map("is_pro_user")
  proSubscriptionExpiry DateTime?     @map("pro_subscription_expiry")
  createdAt             DateTime      @default(now()) @map("created_at") 
  updatedAt             DateTime      @updatedAt @map("updated_at")
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  

  @@map("local_tourist")
}

model Vendor {
  id            Int     @id @default(autoincrement()) @map("vendor_id")
  userId        Int     @unique @map("user_id")
  businessName  String  @map("business_name")
  shortTagline  String? @map("short_tagline")
  contactPhone  String? @map("contact_phone")
  establishedYear       Int?               @map("established_year")
  ratingAverage         Float              @default(0) @map("rating_average")
  ratingCount           Int                @default(0) @map("rating_count")
  verifiedStatus        VerifiedStatus     @default(PENDING) @map("verified_status")
  isProUser             Boolean            @default(false) @map("is_pro_user")
  proSubscriptionExpiry DateTime?          @map("pro_subscription_expiry")
  profileComplete       Boolean            @default(false) @map("profile_complete")
  isActive              Boolean            @default(true) @map("is_active")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  listings              Listing[]
  locations             VendorLocation[]
  goals                 Goal[]
  profileViews          ProfileView[]
  events                Event[]
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  VendorAvailability    VendorAvailability[]

  @@map("vendors")
}

model VendorLocation {
  id             Int       @id @default(autoincrement()) @map("location_id")
  vendorId       Int       @map("vendor_id")
  addressLine1   String    @map("address_line1")
  addressLine2   String?   @map("address_line2")
  city           String
  district       String
  province       String
  postalCode     String?   @map("postal_code")
  latitude       Float?
  longitude      Float?
  isMainLocation Boolean   @default(false) @map("is_main_location")
  listings       Listing[]
  vendor         Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([city])
  @@index([district])
  @@index([province])
  @@map("vendor_locations")
}

model ListingCategory {
  id           Int       @id @default(autoincrement()) @map("category_id")
  categoryName String    @unique @map("category_name")
  isActive     Boolean   @default(true) @map("is_active")
  listings     Listing[]

  @@map("listing_categories")
}

model Listing {
  id          Int         @id @default(autoincrement()) @map("listing_id")
  vendorId    Int         @map("vendor_id")
  categoryId  Int         @map("category_id")
  addressId   Int         @map("address_id")
  listingType ListingType @default(EXPERIENCE) @map("listing_type")

  title            String
  shortDescription String              @map("short_description")
  longDescription  String?             @map("long_description")
  priceMin         Float               @map("price_min")
  priceMax         Float?              @map("price_max")
  priceNote        String?             @map("price_note")
  duration         String?
  capacity         Int?
  availability     String?
  tags             String[]            @default([])
  inclusions       Json?
  specs            Json?
  ratingAverage    Float               @default(0) @map("rating_average")
  ratingCount      Int                 @default(0) @map("rating_count")
  viewsCount       Int                 @default(0) @map("views_count")
  visibilityStatus VisibilityStatus    @default(DRAFT) @map("visibility_status")
  isFeatured       Boolean             @default(false) @map("is_featured")
  displayPriority  Int                 @default(0) @map("display_priority")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  media            ListingMedia[]
  search           ListingSearchIndex?
  location         VendorLocation      @relation(fields: [addressId], references: [id])
  category         ListingCategory     @relation(fields: [categoryId], references: [id])
  vendor           Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  reviews          Review[]
  bookings         Booking[]
  cartItems        CartItem[]
  listingViews     ListingView[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([visibilityStatus])
  @@index([priceMin])
  @@index([priceMax])
  @@map("listings")
}

model ListingMedia {
  id           Int       @id @default(autoincrement()) @map("media_id")
  listingId    Int       @map("listing_id")
  mediaType    MediaType @map("media_type")
  mediaUrl     String    @map("media_url")
  caption      String?
  displayOrder Int       @default(0) @map("display_order")
  isPrimary    Boolean   @default(false) @map("is_primary")
  uploadedAt   DateTime  @default(now()) @map("uploaded_at")
  listing      Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("listing_media")
}

model ListingSearchIndex {
  listingId  Int     @id @map("listing_id")
  categoryId Int     @map("category_id")
  priceMin   Float   @map("price_min")
  priceMax   Float?  @map("price_max")
  city       String
  district   String
  province   String
  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([priceMin])
  @@index([priceMax])
  @@index([city])
  @@index([district])
  @@index([province])
  @@map("listing_search_index")
}

model Review {
  id        Int           @id @default(autoincrement()) @map("review_id")
  listingId Int           @map("listing_id")
  userId    Int           @map("user_id")
  rating    Int
  comment   String
  reply     String?
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  media     ReviewMedia[]
  listing   Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([userId])
  @@map("reviews")
}

model VendorAvailability {
  id       Int      @id @default(autoincrement())
  vendorId Int
  date     DateTime

  vendor Vendor @relation(fields: [vendorId], references: [id])

  slots AvailabilitySlot[]

  createdAt DateTime @default(now())

  @@unique([vendorId, date])
}

model AvailabilitySlot {
  id Int @id @default(autoincrement())

  availabilityId Int

  startTime DateTime
  endTime   DateTime

  availability VendorAvailability @relation(fields: [availabilityId], references: [id])
}

model ReviewMedia {
  id           Int       @id @default(autoincrement()) @map("review_media_id")
  reviewId     Int       @map("review_id")
  mediaType    MediaType @map("media_type")
  mediaUrl     String    @map("media_url")
  displayOrder Int       @default(0) @map("display_order")
  uploadedAt   DateTime  @default(now()) @map("uploaded_at")
  review       Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_media")
}

model ProfileView {
  id        Int      @id @default(autoincrement()) @map("profile_view_id")
  vendorId  Int      @map("vendor_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([vendorId, userId])
  @@index([vendorId])
  @@index([userId])
  @@map("profile_views")
}

model Booking {
  id          Int           @id @default(autoincrement()) @map("booking_id")
  userId      Int           @map("user_id")
  listingId   Int           @map("listing_id")
  bookingDate DateTime      @map("booking_date")
  status      BookingStatus @default(PENDING)
  guests      Int           @default(1)
  totalPrice  Float         @default(0) @map("total_price")
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([listingId])
  @@map("bookings")
}

model Goal {
  id               Int      @id @default(autoincrement()) @map("goal_id")
  vendorId         Int      @map("vendor_id")
  target           Int      @map("target")
  baselineBookings Int      @map("baseline_bookings")
  createdAt        DateTime @default(now()) @map("created_at")
  expiresAt        DateTime
  isActive         Boolean  @default(true) @map("is_active")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, isActive])
  @@index([vendorId])
  @@map("goals")
}

model ListingView {
  id        Int      @id @default(autoincrement())
  listingId Int
  userId    Int?
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([listingId])
  @@index([createdAt])
  @@map("listing_views")
}

model Cart {
  id        Int      @id @default(autoincrement()) @map("cart_id")
  userId    Int?     @unique @map("user_id")
  sessionId String?  @unique @map("session_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items CartItem[]
  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

model CartItem {
  id        Int      @id @default(autoincrement()) @map("cart_item_id")
  cartId    Int      @map("cart_id")
  listingId Int      @map("listing_id")
  quantity  Int      @default(1)
  addedAt   DateTime @default(now()) @map("added_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([cartId, listingId])
  @@map("cart_items")
}

model Event {
  id              Int       @id @default(autoincrement())
  title           String
  description     String?
  startDate       DateTime  @map("start_date")
  endDate         DateTime? @map("end_date")
  time            String? // "09:00 AM - 12:00 PM"
  location        String // display name e.g. "Colombo"
  city            String
  district        String
  province        String
  imageUrl        String?   @map("image_url") // Cloudinary URL
  category        String? // "Cooking", "Cultural", etc.
  price           Float? // null = free
  isFree          Boolean   @default(false) @map("is_free")
  maxParticipants Int?      @map("max_participants")

  vendorId Int?
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  status      EventStatus @default(PUBLISHED)
  isPublished Boolean     @default(true) @map("is_published")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  registrations EventRegistration[]

  @@map("events")
}

model EventRegistration {
  id        Int      @id @default(autoincrement()) @map("registration_id")
  userId    Int      @map("user_id")
  eventId   Int      @map("event_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@map("event_registrations")
}

enum UserRole {
  USER
  ADMIN
}

enum LocalUserType {
  LOCAL
  TOURIST
}

enum VerifiedStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum VisibilityStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum ListingType {
  EXPERIENCE
  PRODUCT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  REJECTED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}